# Variables de conexión a Supabase (Frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Credenciales de usuario de prueba para scripts de validación (scripts/validar-modelo.ts, scripts/probar-servicios.ts)
# Deben ser las credenciales de un usuario existente en Supabase Authentication.
# Se recomienda usar un usuario con rol 'ADMIN' para tener acceso completo a todas las tablas (incluyendo gastos y presupuestos).
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
