# ════════════════════════════════════════════════════════════════════
#  ArizaERP — Variables de entorno
#  Copia este archivo como .env y completa los valores.
#  Nunca subas el .env real al repositorio (está en .gitignore).
# ════════════════════════════════════════════════════════════════════


# ── FRONTEND (Vite) ──────────────────────────────────────────────────
# Estas variables son leídas por la app React en el navegador.
# DEBEN tener el prefijo VITE_ para que Vite las exponga.
# Encuéntralas en: https://supabase.com/dashboard/project/<tu-proyecto>/settings/api

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# App (client) ID de la app registrada en Azure AD para OneDrive.
# Regístrala en: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# Solo necesitas CLIENT_ID aquí (el SECRET nunca va en el frontend).
VITE_ONEDRIVE_CLIENT_ID=

# URI de redirección OAuth2 registrada en Azure AD.
# Debe coincidir EXACTAMENTE con la que configures en el portal de Azure.
# Ejemplo local:      http://localhost:5173/onedrive/callback
# Ejemplo producción: https://tu-dominio.com/onedrive/callback
VITE_ONEDRIVE_REDIRECT_URI=


# ── SCRIPTS DE PRUEBA (Node / vite-node) ────────────────────────────
# Solo se usan en scripts/validar-modelo.ts y scripts/probar-servicios.ts.
# Deben ser las credenciales de un usuario real en Supabase Authentication
# con rol ADMIN (para poder acceder a gastos y presupuestos).

TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Credenciales opcionales de usuario con rol VENDEDOR para validar el aislamiento
# de permisos en scripts/probar-servicios.ts (rechazo de inventario y anulación,
# bloqueo de gastos/presupuestos/onedrive, y creación/actualización legítima con HTTPS).
TEST_VENDEDOR_EMAIL=
TEST_VENDEDOR_PASSWORD=


# ── EDGE FUNCTIONS (Supabase Secrets) ────────────────────────────────
# ¡ATENCIÓN! Las siguientes variables NO van en el .env del frontend.
# Son exclusivamente para los Edge Functions desplegados en Supabase.
# Configúralas como secrets con:
#
#   supabase secrets set CLIENT_ID=xxx CLIENT_SECRET=yyy
#
# O desde el dashboard: Settings → Edge Functions → Manage secrets
#
# Se obtienen al registrar la app en Azure AD:
#   https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
#
# NOTA: TENANT_ID ya NO se usa. Los Edge Functions usan el endpoint
# /consumers/ de Microsoft Identity Platform, que acepta exclusivamente
# cuentas Microsoft personales (outlook.com, hotmail.com, live.com).
#
# Estas variables se incluyen aquí solo como REFERENCIA / DOCUMENTACIÓN
# para el desarrollador. En producción viven únicamente como secrets
# del proyecto Supabase, jamás en un archivo .env local ni en el repo.

# CLIENT_ID=          ← App (client) ID de Azure AD
# CLIENT_SECRET=      ← Client secret generado en Azure AD (sección "Certificates & secrets")
